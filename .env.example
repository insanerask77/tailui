# ── Headscale connection ────────────────────────────────────────────────────
# URL of your Headscale instance (default works if on the same Docker network)
HEADSCALE_URL=http://headscale:8080

# Public URL shown in "Add device" commands (what clients use to reach Headscale)
# Defaults to HEADSCALE_URL if not set — override when behind a reverse proxy or on a different port
# HEADSCALE_PUBLIC_URL=https://headscale.example.com

# API key generated with: headscale apikeys create
HEADSCALE_API_KEY=your_headscale_api_key_here

# ── Admin credentials ────────────────────────────────────────────────────────
ADMIN_USERNAME=admin

# bcrypt hash of your password, base64-encoded (avoids Docker Compose $ interpolation)
# Generated automatically by setup.sh
# Manual: node -e "require('bcryptjs').hash('mypassword',12).then(h=>process.stdout.write(h))" | base64 -w0
ADMIN_PASSWORD_HASH_B64=

# ── Session ──────────────────────────────────────────────────────────────────
# 64-char random string — generated automatically by setup.sh
# Manual: openssl rand -hex 32
SESSION_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
LOG_LEVEL=warn

# Path to headscale config.yaml — enables DNS management in the UI
# In Docker Compose this file is mounted automatically (see docker-compose.yml)
HEADSCALE_CONFIG_PATH=/etc/headscale/config.yaml
