# ── Headscale connection ────────────────────────────────────────────────────
# URL of your Headscale instance (default works if on the same Docker network)
HEADSCALE_URL=http://headscale:8080

# API key generated with: headscale apikeys create
HEADSCALE_API_KEY=your_headscale_api_key_here

# ── Admin credentials ────────────────────────────────────────────────────────
ADMIN_USERNAME=admin

# bcrypt hash of your password — generated automatically by setup.sh
# Manual: node -e "require('bcryptjs').hash('mypassword',12).then(console.log)"
ADMIN_PASSWORD_HASH=

# ── Session ──────────────────────────────────────────────────────────────────
# 64-char random string — generated automatically by setup.sh
# Manual: openssl rand -hex 32
SESSION_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
LOG_LEVEL=warn

# Path to headscale config.yaml — enables DNS management in the UI
# In Docker Compose this file is mounted read/write into the backend container
# HEADSCALE_CONFIG_PATH=/etc/headscale/config.yaml
